# PaddlePass environment.
# Copy to .env.local and fill in. .env.local is gitignored and must stay that way:
# this repository is PUBLIC.

# ---------------------------------------------------------------------------
# Safe in the browser. Both are sent to every visitor by design.
# The publishable key is only safe because Row Level Security is enforced on
# every table and `anon` holds no table privileges at all.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Older projects show this as the "anon" key instead. Either works; set one.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Used to build absolute URLs for auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ -- Next inlines those into the
# client bundle at build time, which would publish the key to a CDN.
#
# Read in exactly one file: src/lib/supabase/admin.ts, whose first line is
# `import 'server-only'`. That makes a leak a build error rather than a
# code-review miss. Mark it "Sensitive" in the Vercel dashboard.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Older projects call this the "service_role" key.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Shared secret guarding /api/cron/expire-holds, used only when pg_cron is
# unavailable and Vercel Cron drives hold expiry instead.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
